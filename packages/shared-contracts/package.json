{
  "name": "@orison/shared-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fs/atomicWrite": {
      "types": "./src/fs/atomicWrite.ts",
      "import": "./src/fs/atomicWrite.ts",
      "default": "./src/fs/atomicWrite.ts"
    },
    "./fs/decodeText": {
      "types": "./src/fs/decodeText.ts",
      "import": "./src/fs/decodeText.ts",
      "default": "./src/fs/decodeText.ts"
    },
    "./fs/naming": {
      "types": "./src/fs/naming.ts",
      "import": "./src/fs/naming.ts",
      "default": "./src/fs/naming.ts"
    },
    "./contracts/channels": {
      "types": "./src/contracts/channels.ts",
      "import": "./src/contracts/channels.ts",
      "default": "./src/contracts/channels.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run",
    "lint": "echo shared-contracts lint placeholder",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
