# ── Dependencies ──
node_modules/
.pnpm-store/
package-lock.json
apps/**/package-lock.json

# ── Build output / artifacts ──
dist/
out/
.vite/
.turbo/
temp/
release/
portable/
*.tsbuildinfo

# ── Test / coverage ──
coverage/
playwright-report/
test-results/

# ── e2e harness artifacts (screenshots / yaml / chapter snapshots per run) ──
# Each e2e run writes to docs/tests/<YYYY-MM-DD>-<story>/ - never commit.
docs/tests/

# ── Secrets / env ──
.env
.env.local
.env.agent.local
*.pem

# ── Local app/runtime data ──
.orison/
logs/

# ── Tooling / editor ──
.DS_Store
.worktrees/
.omc/
# .claude/ 整体本地；例外：Closure 自有 workflow skill（Phase 2.3 强制 gate，无 installer 兜底）随仓版本化；其余（装机 skill / settings.local）维持本地
.claude/*
!.claude/skills
.claude/skills/*
!.claude/skills/closure-code-review/

# ── Local working drafts (plans / reviews / specs) — not version-controlled ──
.scratch/
docs/internal/archive/
docs/internal/*-plan.md

# ── 外部下载的第三方插件项目（非本仓库内容）──
oh-story-claudecode-main/

# ── 外部参考资料（明确不版本控制）──
docs/参考资料（不要git）/

# CodeGraph index (tool artifact)
.codegraph/
# playwright MCP 目检遗留（截图/DOM 快照/控制台日志——临时产物不入库）
.playwright-mcp/

# 测试运行 cwd 残留（rm-residue-registry 登记的已知形态）
apps/**/test-tmp-*/
.gstack/
